{
  "name": "@weibaohui/dsh-kb",
  "version": "0.7.2",
  "description": "dsh 插件 · 团队知识库：离线知识共享（FDE 盒子场景），浏览/全文检索/加工入口；raw 入料自动入队、bot 会话串行蒸馏成文（Karpathy LLM Wiki 模式：raw 不可变 / 两步加工 / log 流水 / 月度 lint）。",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weibaohui/dsh-kb.git"
  },
  "homepage": "https://github.com/weibaohui/dsh-kb#readme",
  "bugs": "https://github.com/weibaohui/dsh-kb/issues",
  "files": [
    "src",
    "client",
    "scripts",
    "skill",
    "docs/demo-kb.gif",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check src/index.js && node --check src/kb-core.js && node --check src/queue.js && node --check client/index.js",
    "test": "node --test \"test/*.test.js\"",
    "build:client": "node scripts/build-client.mjs"
  },
  "keywords": [
    "dsh",
    "kb",
    "knowledge-base",
    "wiki",
    "llm-wiki",
    "auto-distill",
    "fde",
    "offline",
    "full-text-search"
  ],
  "dependencies": {}
}
